# Скопируйте в .env и заполните. Файл .env читается автоматически и не попадает в git.
# Полное описание — README, раздел «Настройка ИИ».

# openai — любой OpenAI-совместимый сервер (облачный шлюз или локальный); anthropic — Claude API; auto — по BASE_URL
AUDIT_LLM_PROVIDER=auto

# Адрес до /chat/completions. Примеры:
#   облачный шлюз   https://<шлюз>/v1
#   OpenRouter      https://openrouter.ai/api/v1
#   Ollama          http://localhost:11434/v1
#   LM Studio       http://localhost:1234/v1
#   vLLM/llama.cpp  http://localhost:8000/v1
AUDIT_LLM_BASE_URL=

# Ключ (для локальных серверов оставьте пустым)
AUDIT_LLM_API_KEY=

# Модель так, как её называет сервер (GET <BASE_URL>/models)
AUDIT_LLM_MODEL=gemini-2.5-flash

# Веб-поиск: auto | google | off  (google — инструмент googleSearch для Gemini за прокси Vertex/LiteLLM)
AUDIT_LLM_WEB_SEARCH=auto

# Режим JSON: json_object | json_schema | off (при отказе сервера включается автоматический повтор без него)
AUDIT_LLM_JSON_MODE=json_object

# Таймаут, сек (для локальных моделей на CPU — 300–600) и лимит ответа
AUDIT_LLM_TIMEOUT=120
AUDIT_LLM_MAX_TOKENS=4000

# Для AUDIT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
