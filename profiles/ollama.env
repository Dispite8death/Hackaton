# No real secrets. The existing .env remains the cloud profile.
AUDIT_LLM_PROVIDER=openai
AUDIT_LLM_BASE_URL=http://127.0.0.1:11434/v1/
AUDIT_LLM_API_KEY=ollama
AUDIT_LLM_MODEL=qwen3.5:9b-q4_K_M
AUDIT_LLM_WEB_SEARCH=off
AUDIT_LLM_JSON_MODE=json_schema
AUDIT_LLM_TIMEOUT=300
AUDIT_LLM_MAX_TOKENS=2048
AUDIT_CACHE_DIR=.cache/local-ollama
# Avoid spending the output budget on thinking instead of the JSON answer.
AUDIT_LLM_REASONING_EFFORT=none
